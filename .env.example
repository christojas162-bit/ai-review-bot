# ==============================================================================
# AI Recruitment & Internship Task Allocation and Review Bot - Environment Config
# ==============================================================================

# Core Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
SECRET_KEY=recruitment-bot-dev-secret-key-change-in-production
LOCAL_TIMEZONE=Asia/Kolkata
DATABASE_PATH=data/recruitment_bot.db

# AI Engine Configuration
# Available Providers: demo | gemini | openai | custom
# When AI_PROVIDER=demo or keys are blank, the bot runs in full intelligent simulation mode.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Email & Notification Settings
# Available Modes: demo | smtp | gmail_api
# In demo mode, all emails are captured in notification logs and email previews without hitting real mailboxes.
EMAIL_MODE=demo
EMAIL_FROM=admissions-recruitment@agency.example.com
EMAIL_FROM_NAME=AI Recruitment & Internship Task Bot
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Google Sheets Integration
# Leave empty to use local CSV fallback.
# For live sync: Create a Google Cloud Service Account, download credentials.json, and share sheet with service account email.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SHEET_NAME=AI Recruitment & Internship Task Review Bot

# APScheduler Background Automation
ENABLE_SCHEDULER=true
SCHEDULER_CHECK_INTERVAL_MINUTES=15
